# AzizBusiness — Environment Configuration
# Copy to .env and fill in values

# Database
DATABASE_URL=postgresql://user:pass@host:5432/azizbusiness

# AI Provider
NOS_API_KEY=your_nous_api_key_here
OPENAI_API_KEY=your_openai_key_optional

# API
API_URL=http://localhost:9999
NEXT_PUBLIC_API_URL=http://localhost:9999

# SSE
NEXT_PUBLIC_SSE_URL=http://localhost:9999/api/workforce/sse

# CORS
CORS_ORIGIN=http://localhost:3000

# Auth
AUTH_SECRET=change-me-in-production
AUTH_URL=http://localhost:3000

# Redis (optional)
REDIS_URL=redis://localhost:6379

# Binance (optional, public API works without key)
BINANCE_API_KEY=
BINANCE_SECRET=
# ── Trendyol e-ticaret modülü (salt-okunur) ─────────────────────────
# Satıcı kimlik bilgileri (Trendyol Partner > Mağaza Ayarları > Entegrasyonlar > API):
MARKETHQ_TRENDYOL_SELLER_ID=
MARKETHQ_TRENDYOL_API_KEY=
MARKE…RET=
# Veri kaynağı modu: auto (varsayılan: kimlik varsa live, yoksa mock) | live | mock | off
# mock = deterministik demo verisi (hesap açılana kadar altyapı testi/demo için)
MARKETHQ_STORE_MODE=auto

# Ticaret kati Postgres (docker aziz-postgres):
MARKETHQ_STORE_DB_URL=

# Yonetici kimligi - node scripts/set-admin-password.mjs ile uretilir (admin hash + secret):
# MARKETHQ_ADMIN_USER=
# MARKETHQ_ADMIN_PASSWORD_HASH=
# MARKETHQ_AUTH_SECRET=
